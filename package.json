{
  "name": "lokeshmohanty-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site and research blog of Lokesh Mohanty",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "predev": "npm run content",
    "dev": "vinxi dev",
    "prebuild": "npm run content",
    "build": "vinxi build",
    "postbuild": "node scripts/finalize-output.mjs && node scripts/check-build.mjs",
    "pretypecheck": "npm run content",
    "typecheck": "tsc --noEmit",
    "preview": "vinxi start",
    "new": "node scripts/new-post.mjs",
    "serve": "npx -y serve .output/public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.3.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.3",
    "@solidjs/start": "^1.3.2",
    "estree-util-value-to-estree": "^3.5.0",
    "katex": "^0.18.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "solid-js": "^1.9.14",
    "solid-mdx": "^0.0.7",
    "unist-util-mdx-define": "^1.1.2",
    "unist-util-visit": "^5.1.0",
    "vinxi": "^0.5.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
